# Supply a private random token before accepting authenticated requests.
RECALL_TOKEN=
RECALL_ENV=development
# Required in production: comma-separated dashboard origins, no wildcard.
RECALL_CORS_ORIGINS=http://localhost:5173
RECALL_DB_PATH=backend/data/recall.sqlite3
RECALL_MEDIA_DIR=backend/media
# Optional results path (use backend/mock/results.json only for MOCK demos)
RECALL_EVALS_PATH=evals/results.json
